---
/**
 * Contact card, made to be pasted into an email signature, downloaded as PDF (scripts/postbuild.mjs)
 * or added to an address book (.vcf, see src/lib/vcard.ts).
 * Email clients only support tables, inline styles and PNG/JPEG images with absolute URLs,
 * hence the old-school markup. Images live in public/card/ so their URLs never change.
 */
import { site } from '../data/site';
import { useTranslations, withBase, type Lang } from '../i18n/ui';
import { toolbar, toolbarCss } from '../lib/toolbar';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const labels = {
  fr: {
    copy: 'Copier la signature',
    copyHtml: 'Copier le HTML',
    vcf: 'Ajouter aux contacts',
    copied: 'Copié !',
    copiedHtml: 'HTML copié !',
  },
  en: {
    copy: 'Copy the signature',
    copyHtml: 'Copy the HTML',
    vcf: 'Add to contacts',
    copied: 'Copied!',
    copiedHtml: 'HTML copied!',
  },
}[lang];

const abs = (path: string) => new URL(withBase(path), Astro.site).href;
const home = abs('/');
const homeLabel = home.replace(/^https?:\/\//, '').replace(/\/$/, '');
const linkedin = site.socials.find((s) => s.id === 'linkedin')!.href;
const github = site.socials.find((s) => s.id === 'github')!.href;

const font = 'font-family:Inter,-apple-system,Segoe UI,Helvetica,Arial,sans-serif;';
const ink = '#151515';
const muted = '#5b5b57';
const green = '#138a45';

const rows = [
  ...(site.phone.show ? [{ icon: abs('/card/phone.png'), href: site.phone.href, text: site.phone.display }] : []),
  { icon: abs('/card/mail.png'), href: `mailto:${site.email}`, text: site.email },
  { icon: abs('/card/web.png'), href: home, text: homeLabel },
];
const socials = [
  { icon: abs('/card/linkedin.png'), href: linkedin, label: 'LinkedIn' },
  { icon: abs('/card/github.png'), href: github, label: 'GitHub' },
];
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{site.name} — Signature</title>
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <style is:global>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-content: center;
        justify-items: center;
        gap: 24px;
        padding: 48px 16px;
        background: #f6f5f2;
        font-family: Inter, system-ui, sans-serif;
        color: #151515;
      }
      .tools {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 12px;
        font-size: 14px;
      }
      .tools button,
      .tools a {
        box-sizing: border-box;
        display: inline-flex;
        align-items: center;
        height: 40px;
        padding: 0 18px;
        border-radius: 999px;
        border: 1px solid #d5d9d6;
        background: #fff;
        color: #151515;
        font: 500 14px/1 Inter, system-ui, sans-serif;
        text-decoration: none;
        cursor: pointer;
      }
      .tools button {
        background: #138a45;
        border-color: #138a45;
        color: #fff;
      }
      .tools button.secondary {
        background: #fff;
        border-color: #d5d9d6;
        color: #151515;
      }
      .tools span {
        color: #138a45;
        min-width: 4em;
      }
      /* The PDF holds the card alone, on a page cut to its size (scripts/postbuild.mjs). */
      @media print {
        @page { margin: 0; }
        body { display: block; min-height: 0; padding: 0; background: #fff; }
        .tools { display: none; }
      }
    </style>
    <style is:inline set:html={toolbarCss}></style>
  </head>
  <body>
    <div id="card">
      <table
        role="presentation"
        cellpadding="0"
        cellspacing="0"
        border="0"
        style={`${font}background:#ffffff;border:1px solid #e2e0da;border-radius:16px;border-collapse:separate;`}
      >
        <tr>
          <td style="padding:20px 0 20px 20px;vertical-align:top;width:80px;">
            <a href={home} style="text-decoration:none;">
              <img src={abs('/card/me.png')} width="80" height="80" alt={site.name} style="display:block;border:0;border-radius:16px;" />
            </a>
          </td>
          <td style="padding:20px 24px 20px 18px;vertical-align:top;">
            <div style={`${font}font-size:19px;line-height:24px;font-weight:700;color:${ink};letter-spacing:-0.2px;`}>
              {site.name}
            </div>
            <div style={`${font}font-size:13px;line-height:18px;font-weight:600;color:${green};padding-top:2px;`}>
              {t('hero.role')}
            </div>
            <div style="height:1px;line-height:1px;font-size:0;background:#ece9e3;margin:12px 0 10px;">&nbsp;</div>
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
              {
                rows.map((r) => (
                  <tr>
                    <td style="padding:2px 8px 2px 0;vertical-align:middle;width:16px;">
                      <img src={r.icon} width="16" height="16" alt="" style="display:block;border:0;" />
                    </td>
                    <td style={`${font}font-size:13px;line-height:20px;vertical-align:middle;`}>
                      <a href={r.href} style={`color:${muted};text-decoration:none;`}>
                        {r.text}
                      </a>
                    </td>
                  </tr>
                ))
              }
            </table>
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:12px;">
              <tr>
                {
                  socials.map((s) => (
                    <td style="padding-right:8px;vertical-align:middle;">
                      <a href={s.href} title={s.label} style="text-decoration:none;">
                        <img src={s.icon} width="28" height="28" alt={s.label} style="display:block;border:0;" />
                      </a>
                    </td>
                  ))
                }
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </div>

    <div class="tools">
      <button type="button" id="copy">{labels.copy}</button>
      <button type="button" id="copy-html" class="secondary">{labels.copyHtml}</button>
      <a href={withBase(site.card[lang].vcf)} download>{labels.vcf}</a>
      <span id="status" role="status" aria-live="polite" data-copied={labels.copied} data-copied-html={labels.copiedHtml}
      ></span>
    </div>

    <Fragment set:html={toolbar(lang, 'Signature', { fr: site.card.fr.page, en: site.card.en.page }, site.card[lang].pdf)} />

    <script>
      const card = document.getElementById('card')!;
      const status = document.getElementById('status')!;
      const notify = (text: string) => {
        status.textContent = text;
        setTimeout(() => (status.textContent = ''), 2000);
      };
      document.getElementById('copy')!.addEventListener('click', async () => {
        try {
          // Rich copy: paste it in the signature settings of the mail client.
          await navigator.clipboard.write([
            new ClipboardItem({
              'text/html': new Blob([card.innerHTML], { type: 'text/html' }),
              'text/plain': new Blob([card.innerText], { type: 'text/plain' }),
            }),
          ]);
        } catch {
          // Fallback: copy the selection.
          const range = document.createRange();
          range.selectNode(card);
          const selection = getSelection()!;
          selection.removeAllRanges();
          selection.addRange(range);
          document.execCommand('copy');
          selection.removeAllRanges();
        }
        notify(status.dataset.copied!);
      });
      document.getElementById('copy-html')!.addEventListener('click', async () => {
        // Source code, for mail clients whose signature settings take raw HTML (Thunderbird, Outlook…).
        const html = card.innerHTML.trim();
        try {
          await navigator.clipboard.writeText(html);
        } catch {
          const area = document.createElement('textarea');
          area.value = html;
          document.body.append(area);
          area.select();
          document.execCommand('copy');
          area.remove();
        }
        notify(status.dataset.copiedHtml!);
      });
    </script>
  </body>
</html>
