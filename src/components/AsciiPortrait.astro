---
import { Image } from 'astro:assets';
import portrait from '../assets/me.jpg';

interface Props {
  label: string;
  /** Short call to action under the portrait, for mouse and touch screens. */
  hint: { hover: string; touch: string };
}
const { label, hint } = Astro.props;
---

<figure class="ascii" data-ascii>
  <button type="button" class="ascii-stage" aria-pressed="false" aria-label={label}>
    <canvas aria-hidden="true"></canvas>
    <Image src={portrait} alt="" width={720} height={720} loading="eager" fetchpriority="high" />
  </button>
  <figcaption aria-hidden="true">
    <span class="hint"><span class="on-hover">{hint.hover}</span><span class="on-touch">{hint.touch}</span></span>
    <span class="file"><span>me.jpg</span><span class="arrow">→</span><span>ascii</span></span>
  </figcaption>
</figure>

<style>
  @property --r {
    syntax: '<length-percentage>';
    inherits: true;
    initial-value: 0px;
  }

  .ascii {
    margin: 0;
    width: 100%;
  }
  .ascii-stage {
    --x: 50%;
    --y: 40%;
    --r: 0px;
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    /* Printed-paper look, identical in both themes so the portrait stays readable. */
    background: #f3f1ec;
    box-shadow: var(--shadow);
    overflow: hidden;
    cursor: crosshair;
    transition: --r 0.35s ease;
    touch-action: pan-y;
  }
  canvas,
  .ascii-stage :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ascii-stage :global(img) {
    object-fit: cover;
  }
  /* Once the ASCII rendering is ready, the photo only shows through the lens. */
  :global(.ascii-ready) .ascii-stage :global(img) {
    -webkit-mask-image: radial-gradient(circle at var(--x) var(--y), #000 calc(var(--r) - 1px), transparent var(--r));
    mask-image: radial-gradient(circle at var(--x) var(--y), #000 calc(var(--r) - 1px), transparent var(--r));
  }
  .ascii-stage[aria-pressed='true'] {
    --r: 150%;
  }

  figcaption {
    display: flex;
    gap: 8px;
    justify-content: space-between;
    margin-top: 10px;
    font: 0.75rem var(--font-mono);
    color: var(--text-muted);
  }
  .file {
    display: flex;
    gap: 8px;
  }
  .arrow {
    color: var(--accent);
  }
  .hint {
    color: var(--accent);
  }
  .hint::before {
    content: '↖ ';
  }
  .on-touch {
    display: none;
  }
  @media (hover: none) {
    .on-hover {
      display: none;
    }
    .on-touch {
      display: inline;
    }
  }
  /* The hint disappears once the visitor has found the lens. */
  .ascii.found .hint {
    visibility: hidden;
  }
</style>

<script>
  const RAMP = ' .:-=+*#%@';
  const INK = '#161616';
  const ACCENT = '#138a45';
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  async function setup(root: HTMLElement) {
    const stage = root.querySelector<HTMLButtonElement>('.ascii-stage')!;
    const canvas = root.querySelector('canvas')!;
    const img = root.querySelector('img')!;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    if (!img.complete) await new Promise((r) => img.addEventListener('load', r, { once: true }));
    await document.fonts.load('16px "JetBrains Mono"').catch(() => {});

    let cols = 0;
    let rows = 0;
    let cellW = 0;
    let cellH = 0;
    let lum = new Float32Array(0);
    let settleAt = new Float32Array(0);

    function sample() {
      const size = stage.clientWidth;
      cols = Math.round(Math.min(110, Math.max(56, size / 6)));
      cellW = size / cols;
      cellH = cellW / 0.6;
      rows = Math.ceil(size / cellH);
      const off = document.createElement('canvas');
      off.width = cols;
      off.height = rows;
      const o = off.getContext('2d', { willReadFrequently: true })!;
      o.drawImage(img, 0, 0, cols, rows);
      const data = o.getImageData(0, 0, cols, rows).data;
      lum = new Float32Array(cols * rows);
      for (let i = 0; i < lum.length; i++) {
        lum[i] = (0.2126 * data[i * 4] + 0.7152 * data[i * 4 + 1] + 0.0722 * data[i * 4 + 2]) / 255;
      }
      // Contrast stretch between the 3rd and 90th percentiles, so the light backdrop turns blank.
      const sorted = Float32Array.from(lum).sort();
      const lo = sorted[Math.floor(sorted.length * 0.03)];
      const hi = sorted[Math.floor(sorted.length * 0.9)];
      for (let i = 0; i < lum.length; i++) {
        lum[i] = Math.min(1, Math.max(0, (lum[i] - lo) / (hi - lo || 1)));
      }
      settleAt = Float32Array.from(lum, () => Math.random());

      const dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.round(size * dpr);
      canvas.height = Math.round(size * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function draw(progress = 1) {
      ctx!.clearRect(0, 0, canvas.width, canvas.height);
      ctx!.font = `${cellH * 0.92}px "JetBrains Mono", monospace`;
      ctx!.textBaseline = 'top';
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const i = y * cols + x;
          const v = Math.pow(1 - lum[i], 1.15);
          const settled = settleAt[i] <= progress;
          const ch = settled
            ? RAMP[Math.min(RAMP.length - 1, Math.floor(v * RAMP.length))]
            : RAMP[1 + Math.floor(Math.random() * (RAMP.length - 1))];
          if (ch === ' ') continue;
          ctx!.fillStyle = settled ? INK : ACCENT;
          ctx!.globalAlpha = settled ? 0.45 + v * 0.55 : 0.7;
          ctx!.fillText(ch, x * cellW, y * cellH);
        }
      }
      ctx!.globalAlpha = 1;
    }

    sample();
    if (reduceMotion) {
      draw();
    } else {
      const start = performance.now();
      const duration = 1400;
      const frame = (now: number) => {
        const p = Math.min(1, (now - start) / duration);
        draw(p * p * (3 - 2 * p));
        if (p < 1) requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }
    root.classList.add('ascii-ready');

    // Lens that reveals the photo under the pointer.
    stage.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const r = stage.getBoundingClientRect();
      stage.style.setProperty('--x', `${e.clientX - r.left}px`);
      stage.style.setProperty('--y', `${e.clientY - r.top}px`);
      if (stage.getAttribute('aria-pressed') !== 'true') stage.style.setProperty('--r', '22%');
      root.classList.add('found');
    });
    stage.addEventListener('pointerleave', () => stage.style.removeProperty('--r'));
    stage.addEventListener('click', () => {
      const pressed = stage.getAttribute('aria-pressed') === 'true';
      stage.setAttribute('aria-pressed', String(!pressed));
      root.classList.add('found');
      stage.style.removeProperty('--r');
    });

    let width = stage.clientWidth;
    new ResizeObserver(() => {
      if (stage.clientWidth === width) return;
      width = stage.clientWidth;
      sample();
      draw();
    }).observe(stage);
  }

  document.querySelectorAll<HTMLElement>('[data-ascii]').forEach((el) => void setup(el));
</script>
