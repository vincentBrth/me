---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import { getProjects, isOpenSource, md, plain, type Project } from '../lib/content';
import { categories, localePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const { data } = project;
const title = data.title[lang];

// Archived projects keep their page but are left out of the previous/next navigation.
const all = (await getProjects()).filter((p) => !p.data.archived || p.id === project.id);
const index = all.findIndex((p) => p.id === project.id);
const prev = all[(index - 1 + all.length) % all.length];
const next = all[(index + 1) % all.length];
const back = `${localePath(lang, '/')}#projects`;
---

<Layout lang={lang} path={`/projects/${project.id}`} title={title} description={plain(data.summary[lang])}>
  <article class="container project">
    <a class="back" href={back}><Icon name="arrow-left" /> {t('project.back')}</a>

    <header>
      <p class="eyebrow">{data.categories.map((c) => categories[c][lang]).join(' · ')}</p>
      <h1>{title}</h1>
      <p class="lead" set:html={md(data.summary[lang], true)} />
      <p class="badges">
        {
          data.featured && (
            <span class="pill accent">
              <Icon name="star" /> {t('project.featured')}
            </span>
          )
        }
        {
          isOpenSource(project) && (
            <span class="pill">
              <Icon name="github" /> {t('project.openSource')}
            </span>
          )
        }
        {data.year && <span class="pill">{data.year}</span>}
        {
          data.archived && (
            <span class="pill archived">
              <Icon name="archive" /> {t('project.archived')}
            </span>
          )
        }
      </p>
      {data.wip && <p class="notice">{t('project.wip')}</p>}
      {data.mobileOnly && <p class="notice">{t('project.mobile')}</p>}
    </header>

    <div class="layout">
      <div class="main">
        {
          data.video ? (
            <div class="embed" style={`view-transition-name: cover-${project.id}`} data-youtube={data.video} data-title={`${t('project.video')} — ${title}`}>
              {data.cover && <Image src={data.cover} alt="" widths={[640, 960, 1280]} sizes="(min-width: 1000px) 720px, 100vw" />}
              <div class="play">
                <button type="button" class="btn btn-accent">
                  <Icon name="play" /> {t('project.playVideo')}
                </button>
                <small>{t('project.videoHint')}</small>
              </div>
            </div>
          ) : data.webgl ? (
            <div class="embed" style={`view-transition-name: cover-${project.id}`}>
              {data.cover && <Image src={data.cover} alt="" widths={[640, 960, 1280]} sizes="(min-width: 1000px) 720px, 100vw" />}
              <div class="play">
                <a class="btn btn-accent" href={data.webgl}>
                  <Icon name="play" /> {t('project.play')}
                </a>
                <small>{t('project.playHint')}</small>
              </div>
            </div>
          ) : (
            data.cover && (
              <Image
                class="cover"
                style={`view-transition-name: cover-${project.id}`}
                src={data.cover}
                alt={title}
                widths={[640, 960, 1280]}
                sizes="(min-width: 1000px) 720px, 100vw"
              />
            )
          )
        }
        {data.description && <div class="prose" set:html={md(data.description[lang])} />}
        {
          data.gallery.length > 0 && (
            <section class="gallery" aria-label={t('project.gallery')}>
              {data.gallery.map((g) => (
                <a href={g.src.src}>
                  <Image src={g.src} alt={g.alt?.[lang] ?? ''} widths={[480, 960]} sizes="(min-width: 1000px) 360px, 100vw" />
                </a>
              ))}
            </section>
          )
        }
      </div>

      <aside>
        {
          data.year && (
            <div>
              <h2>{t('project.year')}</h2>
              <p>{data.year}</p>
            </div>
          )
        }
        {
          data.stack.length > 0 && (
            <div>
              <h2>{t('project.stack')}</h2>
              <ul class="tags">
                {data.stack.map((s) => (
                  <li class="tag">{s}</li>
                ))}
              </ul>
            </div>
          )
        }
        {
          (data.links.source || data.links.website || data.links.demo || data.links.download) && (
            <div>
              <h2>{t('project.links')}</h2>
              <ul class="links">
                {data.links.website && (
                  <li>
                    <a class="btn btn-primary" href={data.links.website}>
                      <Icon name="globe" /> {t('project.website')}
                    </a>
                  </li>
                )}
                {data.links.demo && (
                  <li>
                    <a class="btn btn-primary" href={data.links.demo}>
                      <Icon name="arrow-up-right" /> {t('project.demo')}
                    </a>
                  </li>
                )}
                {data.links.source && (
                  <li>
                    <a class="btn" href={data.links.source}>
                      <Icon name="github" /> {t('project.source')}
                    </a>
                  </li>
                )}
                {data.links.download && (
                  <li>
                    <a class="btn btn-accent" href={data.links.download.url}>
                      <Icon name="download" /> {t('project.download')}
                    </a>
                    <small>
                      {data.links.download.name}
                      {data.links.download.lang === 'fr' && lang !== 'fr' && <> · {t('project.docLang')}</>}
                    </small>
                  </li>
                )}
              </ul>
            </div>
          )
        }
      </aside>
    </div>

    <nav class="pager" aria-label="Projects">
      <a href={localePath(lang, `/projects/${prev.id}`)} rel="prev">
        <small><Icon name="arrow-left" /> {t('project.prev')}</small>
        <span>{prev.data.title[lang]}</span>
      </a>
      <a href={localePath(lang, `/projects/${next.id}`)} rel="next" class="next">
        <small>{t('project.next')} <Icon name="arrow-right" /></small>
        <span>{next.data.title[lang]}</span>
      </a>
    </nav>
  </article>
</Layout>


<script>
  // YouTube is only contacted once the visitor asks for the video.
  document.querySelectorAll<HTMLElement>('[data-youtube]').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${el.dataset.youtube}?autoplay=1`;
      frame.title = el.dataset.title ?? '';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      el.replaceChildren(frame);
    });
  });
</script>

<style>
  .project {
    padding-block: 32px 96px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--text-muted);
    margin-bottom: 40px;
  }
  .back :global(svg),
  .pager :global(svg) {
    width: 16px;
    height: 16px;
  }
  header {
    max-width: 820px;
    margin-bottom: 48px;
  }
  h1 {
    font-size: clamp(2.25rem, 6vw, 4rem);
    letter-spacing: -0.03em;
    margin-bottom: 20px;
  }
  .lead {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: var(--text-muted);
  }
  .lead :global(a) {
    color: var(--accent);
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .badges:empty {
    display: none;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    font: 500 0.78rem var(--font-mono);
  }
  .pill :global(svg) {
    width: 14px;
    height: 14px;
  }
  .pill.archived {
    border-style: dashed;
    color: var(--text-muted);
  }
  .pill.accent {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .pill.accent :global(svg) {
    fill: currentColor;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 12px;
  }
  .gallery a {
    display: block;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .gallery :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .notice {
    display: inline-block;
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent);
    font: 0.85rem var(--font-mono);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .main > :global(* + *) {
    margin-top: 32px;
  }
  .main :global(.cover),
  .embed {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .embed {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .embed :global(iframe),
  .embed :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }
  .embed :global(img) {
    opacity: 0.45;
  }
  .play {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 12px;
    padding: 16px;
    text-align: center;
    color: #fff;
  }

  aside {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: grid;
    gap: 28px;
  }
  aside h2 {
    font: 500 0.75rem var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 10px;
  }
  aside p {
    margin: 0;
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .links .btn {
    width: 100%;
    justify-content: center;
  }
  .links small {
    display: block;
    margin-top: 6px;
    color: var(--text-muted);
    font-size: 0.78rem;
    overflow-wrap: anywhere;
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }
    aside {
      position: static;
    }
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 96px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .pager a {
    display: grid;
    gap: 4px;
    padding: 16px;
    border-radius: var(--radius);
    text-decoration: none;
  }
  .pager a:hover {
    background: var(--bg-elevated);
  }
  .pager small {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    font: 0.8rem var(--font-mono);
  }
  .pager span {
    font: 600 1.1rem var(--font-display);
  }
  .pager .next {
    text-align: right;
    justify-items: end;
  }
</style>
