---
/**
 * Template of the social sharing image (Open Graph), 1200×630.
 * scripts/postbuild.mjs takes a screenshot of it after the build: dist/og/<lang>.png.
 */
import '../../styles/global.css';
import AsciiPortrait from '../../components/AsciiPortrait.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'fr' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>OG</title>
  </head>
  <body>
    <div class="og">
      <div class="text">
        <p class="eyebrow">hello world</p>
        <h1>Vincent<br />Berthet<span>.</span></h1>
        <p class="role">{t('hero.role')}</p>
        <p class="url">vincentbrth.github.io/me</p>
      </div>
      <div class="portrait">
        <AsciiPortrait label="" hint={{ hover: '', touch: '' }} />
      </div>
    </div>
  </body>
</html>

<style>
  body {
    margin: 0;
    width: 1200px;
    height: 630px;
    overflow: hidden;
  }
  .og {
    box-sizing: border-box;
    width: 1200px;
    height: 630px;
    padding: 64px 72px;
    display: grid;
    grid-template-columns: 1fr 480px;
    gap: 56px;
    align-items: center;
    background: radial-gradient(circle at 0% 100%, var(--accent-soft), transparent 55%), var(--bg);
  }
  .eyebrow {
    font-size: 20px;
  }
  h1 {
    font-size: 112px;
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin-bottom: 28px;
  }
  h1 span {
    color: var(--accent);
  }
  .role {
    font: 500 28px/1.3 var(--font-display);
    margin-bottom: 40px;
  }
  .url {
    font: 20px var(--font-mono);
    color: var(--accent);
    margin: 0;
  }
  .portrait :global(figcaption) {
    display: none;
  }
</style>
