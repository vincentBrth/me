---
/**
 * Contact card, made to be pasted into an email signature.
 * Email clients only support tables, inline styles and PNG/JPEG images with absolute URLs,
 * hence the old-school markup. Images live in public/card/ so their URLs never change.
 */
import { site } from '../data/site';
import { useTranslations, withBase } from '../i18n/ui';

const t = useTranslations('fr');
const abs = (path: string) => new URL(withBase(path), Astro.site).href;
const home = abs('/');
const homeLabel = home.replace(/^https?:\/\//, '').replace(/\/$/, '');
const linkedin = site.socials.find((s) => s.id === 'linkedin')!.href;
const github = site.socials.find((s) => s.id === 'github')!.href;

const font = 'font-family:Inter,-apple-system,Segoe UI,Helvetica,Arial,sans-serif;';
const ink = '#151515';
const muted = '#5b5b57';
const green = '#138a45';

const rows = [
  ...(site.phone.show ? [{ icon: abs('/card/phone.png'), href: site.phone.href, text: site.phone.display }] : []),
  { icon: abs('/card/mail.png'), href: `mailto:${site.email}`, text: site.email },
  { icon: abs('/card/web.png'), href: home, text: homeLabel },
];
const socials = [
  { icon: abs('/card/linkedin.png'), href: linkedin, label: 'LinkedIn' },
  { icon: abs('/card/github.png'), href: github, label: 'GitHub' },
];
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{site.name} — Signature</title>
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <style is:global>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-content: center;
        gap: 24px;
        padding: 48px 16px;
        background: #f6f5f2;
        font-family: Inter, system-ui, sans-serif;
        color: #151515;
      }
      .tools {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 12px;
        font-size: 14px;
      }
      .tools button,
      .tools a {
        box-sizing: border-box;
        display: inline-flex;
        align-items: center;
        height: 40px;
        padding: 0 18px;
        border-radius: 999px;
        border: 1px solid #d5d9d6;
        background: #fff;
        color: #151515;
        font: 500 14px/1 Inter, system-ui, sans-serif;
        text-decoration: none;
        cursor: pointer;
      }
      .tools button {
        background: #138a45;
        border-color: #138a45;
        color: #fff;
      }
      .tools span {
        color: #138a45;
        min-width: 4em;
      }
    </style>
  </head>
  <body>
    <div id="card">
      <table
        role="presentation"
        cellpadding="0"
        cellspacing="0"
        border="0"
        style={`${font}background:#ffffff;border:1px solid #e2e0da;border-radius:16px;border-collapse:separate;`}
      >
        <tr>
          <td style="padding:20px 0 20px 20px;vertical-align:top;width:80px;">
            <a href={home} style="text-decoration:none;">
              <img src={abs('/card/me.png')} width="80" height="80" alt={site.name} style="display:block;border:0;border-radius:16px;" />
            </a>
          </td>
          <td style="padding:20px 24px 20px 18px;vertical-align:top;">
            <div style={`${font}font-size:19px;line-height:24px;font-weight:700;color:${ink};letter-spacing:-0.2px;`}>
              {site.name}
            </div>
            <div style={`${font}font-size:13px;line-height:18px;font-weight:600;color:${green};padding-top:2px;`}>
              {t('hero.role')}
            </div>
            <div style="height:1px;line-height:1px;font-size:0;background:#ece9e3;margin:12px 0 10px;">&nbsp;</div>
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
              {
                rows.map((r) => (
                  <tr>
                    <td style="padding:2px 8px 2px 0;vertical-align:middle;width:16px;">
                      <img src={r.icon} width="16" height="16" alt="" style="display:block;border:0;" />
                    </td>
                    <td style={`${font}font-size:13px;line-height:20px;vertical-align:middle;`}>
                      <a href={r.href} style={`color:${muted};text-decoration:none;`}>
                        {r.text}
                      </a>
                    </td>
                  </tr>
                ))
              }
            </table>
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:12px;">
              <tr>
                {
                  socials.map((s) => (
                    <td style="padding-right:8px;vertical-align:middle;">
                      <a href={s.href} title={s.label} style="text-decoration:none;">
                        <img src={s.icon} width="28" height="28" alt={s.label} style="display:block;border:0;" />
                      </a>
                    </td>
                  ))
                }
                <td style="vertical-align:middle;">
                  <a
                    href={abs(site.cv.page)}
                    style={`${font}display:inline-block;font-size:12px;line-height:28px;font-weight:600;color:#ffffff;background:${green};border-radius:14px;padding:0 14px;text-decoration:none;`}
                  >
                    Mon CV &rarr;
                  </a>
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </div>

    <div class="tools">
      <button type="button" id="copy">Copier la signature</button>
      <a href={home}>Voir le site</a>
      <span id="status" role="status" aria-live="polite"></span>
    </div>

    <script>
      const card = document.getElementById('card')!;
      const status = document.getElementById('status')!;
      document.getElementById('copy')!.addEventListener('click', async () => {
        try {
          // Rich copy: paste it in the signature settings of the mail client.
          await navigator.clipboard.write([
            new ClipboardItem({
              'text/html': new Blob([card.innerHTML], { type: 'text/html' }),
              'text/plain': new Blob([card.innerText], { type: 'text/plain' }),
            }),
          ]);
        } catch {
          // Fallback: copy the selection.
          const range = document.createRange();
          range.selectNode(card);
          const selection = getSelection()!;
          selection.removeAllRanges();
          selection.addRange(range);
          document.execCommand('copy');
          selection.removeAllRanges();
        }
        status.textContent = 'Copié !';
        setTimeout(() => (status.textContent = ''), 2000);
      });
    </script>
  </body>
</html>
